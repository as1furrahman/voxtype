        "bezel_alpha": 0.12,
    },
}


def draw_rounded_capsule(cr, x, y, w, h, r):
    """Draw a smooth rounded capsule path in Cairo."""
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


class DynamicIslandOSD(Gtk.Window):
    def __init__(self, demo_mode=False, theme_name="dark-glass", top_margin=36):
        super().__init__(type=Gtk.WindowType.POPUP)
        self.set_title("Voxtype Liquid Glass Dynamic Island")
        self.set_decorated(False)
        self.set_resizable(False)

        self.demo_mode = demo_mode
        self.theme = THEMES.get(theme_name, THEMES["dark-glass"])
        self.top_margin = top_margin

        # Transparent ARGB visual for glass compositing
        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual:
            self.set_visual(visual)
        self.set_app_paintable(True)

        self.update_position()

        # Input shape pass-through: clicks pass right through to underlying desktop
        self.connect('map', lambda w: self.input_shape_combine_region(cairo.Region()))
        self.connect('destroy', self.on_destroy)

        self.area = Gtk.DrawingArea()
        self.area.connect('draw', self.draw)
        self.add(self.area)

        self.current_state = "recording" if self.demo_mode else "idle"
        self.anim_time = 0.0
        self.tick_count = 0
        self.last_tick_time = time.time()
        self.recording_start_time = time.time() if self.demo_mode else None

        # Real-time microphone audio metrics & adaptive noise floor
        self.noise_floor_dbfs = -30.0
        self.incoming_vol_peak = 0.0
        self.smooth_voice_level = 0.0
        self.pearl_levels = [0.0, 0.0, 0.0, 0.0]
        self.last_audio_packet_time = 0.0
        self.shutdown = False

        if not self.demo_mode:
            self.audio_thread = threading.Thread(target=self.audio_socket_loop, daemon=True)
            self.audio_thread.start()
        else:
            self.show_all()

        # 60 FPS smooth rendering loop (16ms)
        GLib.timeout_add(16, self.tick)

    def on_destroy(self, *args):
        self.shutdown = True
        Gtk.main_quit()

    def update_position(self):
        """Calculate and apply exact coordinates centered on the active monitor."""
        mon_w = 1920
        mon_x = 0
        mon_y = 0
        try:
            display = Gdk.Display.get_default()
            if display:
                seat = display.get_default_seat()
                pointer = seat.get_pointer()
                _, px, py = pointer.get_position()
                monitor = display.get_monitor_at_point(px, py)
                if not monitor and display.get_n_monitors() > 0:
                    monitor = display.get_primary_monitor() or display.get_monitor(0)
                if monitor:
                    geo = monitor.get_geometry()
                    mon_w = geo.width
                    mon_x = geo.x
                    mon_y = geo.y
        except Exception:
            pass

        target_x = mon_x + (mon_w // 2) - (CANVAS_WIDTH // 2)
        target_y = mon_y + self.top_margin
        self.set_default_size(CANVAS_WIDTH, CANVAS_HEIGHT)
        self.move(target_x, target_y)

    def audio_socket_loop(self):
        """Streams real dBFS audio levels directly from Voxtype's audio.sock with adaptive noise floor."""
        while not self.shutdown:
            s = None
            buf = bytearray()
            try:
                if not os.path.exists(SOCKET_FILE):
                    self.incoming_vol_peak = 0.0
                    time.sleep(0.2)
                    continue

                s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                s.connect(SOCKET_FILE)
                s.settimeout(0.08)
                buf.clear()

                while not self.shutdown:
                    try:
                        chunk = s.recv(128)
                        if not chunk:
                            break
                        buf.extend(chunk)

                        while len(buf) >= 16:
                            packet = buf[:16]
                            del buf[:16]
                            seq, f1, f2, peak_dbfs = struct.unpack('<Ifff', packet)

                            now = time.time()
                            # Check recording elapsed time to skip startup audio feedback beep
                            elapsed = (now - self.recording_start_time) if self.recording_start_time else 0.0

                            if not math.isfinite(peak_dbfs) or peak_dbfs < -100.0:
                                continue

                            # Skip the first 180ms startup audio feedback beep from distorting noise floor
                            if elapsed < 0.18:
                                continue

                            # Adaptively track ambient background noise floor
                            if -60.0 <= peak_dbfs < self.noise_floor_dbfs:
                                # Rapidly adapt downward to quieter room state
                                self.noise_floor_dbfs += (peak_dbfs - self.noise_floor_dbfs) * 0.12
                            elif -22.0 > peak_dbfs >= self.noise_floor_dbfs:
                                # Very slowly drift upward to track ambient background changes (fan, AC)
                                self.noise_floor_dbfs += (peak_dbfs - self.noise_floor_dbfs) * 0.003

                            self.noise_floor_dbfs = max(-45.0, min(-25.0, self.noise_floor_dbfs))

                            # Speech threshold sits 3.5 dB above the adaptive ambient noise floor
                            thresh = self.noise_floor_dbfs + 3.5
                            if peak_dbfs <= thresh:
                                vol = 0.0
                            else:
                                snr = (peak_dbfs - thresh) / max(14.0, -5.0 - thresh)
                                vol = min(1.0, max(0.0, snr)) ** 0.85

                            # Retain peak volume in this burst for the UI tick
                            if vol > self.incoming_vol_peak:
                                self.incoming_vol_peak = vol

                            self.last_audio_packet_time = now

                    except socket.timeout:
                        if time.time() - self.last_audio_packet_time > 0.20:
                            self.incoming_vol_peak = 0.0
            except Exception:
                self.incoming_vol_peak = 0.0
                time.sleep(0.2)
            finally:
                buf.clear()
                if s:
                    try:
                        s.close()
                    except Exception:
                        pass

    def tick(self):
        self.tick_count += 1
        now = time.time()
        dt = max(0.0, min(0.1, now - self.last_tick_time))
        self.last_tick_time = now

        # Demo mode simulates live speech cadence and state transitions
        if self.demo_mode:
            self.anim_time += dt
            cycle = (self.anim_time % 12.0)
            if cycle < 9.0:
                if self.current_state != "recording":
                    self.current_state = "recording"
                    self.recording_start_time = now
                    self.incoming_vol_peak = 0.0
                    self.smooth_voice_level = 0.0
                    self.pearl_levels = [0.0, 0.0, 0.0, 0.0]
                # Natural speech rhythm: 2.2s speaking phrase, 1.4s silent pause
                sub_cycle = (self.anim_time % 3.6)
                if sub_cycle < 2.2:
                    syllable = math.sin(self.anim_time * 9.0) * 0.5 + 0.5
                    phrase_env = math.sin((sub_cycle / 2.2) * math.pi)
                    self.incoming_vol_peak = max(self.incoming_vol_peak, (0.35 + 0.65 * syllable) * phrase_env)
                else:
                    self.incoming_vol_peak = 0.0
            else:
                self.current_state = "transcribing"
        else:
            # Production: Check state file every ~48ms (every 3rd tick)
            if self.tick_count % 3 == 0:
                new_state = "idle"
                if os.path.exists(STATE_FILE):
                    try:
                        with open(STATE_FILE, 'r') as f:
                            content = f.read().strip().lower()
                            if content in ("recording", "transcribing"):
                                new_state = content
                    except Exception:
                        pass

                if new_state != self.current_state:
                    prev_state = self.current_state
                    self.current_state = new_state

                    if self.current_state == "recording":
                        if prev_state != "recording":
                            self.recording_start_time = now
                            self.incoming_vol_peak = 0.0
                            self.smooth_voice_level = 0.0
                            self.pearl_levels = [0.0, 0.0, 0.0, 0.0]
                        self.update_position()
                        self.show_all()
                        self.input_shape_combine_region(cairo.Region())
                    elif self.current_state == "transcribing":
                        self.update_position()
                        self.show_all()
                        self.input_shape_combine_region(cairo.Region())
                    else:
                        self.hide()
                        self.recording_start_time = None
                        self.incoming_vol_peak = 0.0
                        self.smooth_voice_level = 0.0
                        self.pearl_levels = [0.0, 0.0, 0.0, 0.0]

        if self.get_visible():
            if not self.demo_mode:
                self.anim_time += dt

            # Sample incoming voice peak
            target = self.incoming_vol_peak if self.current_state == "recording" else 0.0
            self.incoming_vol_peak *= 0.35

            # Dynamic master ballistics: fast attack (0.75) for syllables, smooth decay (0.18)
            if target > self.smooth_voice_level:
                self.smooth_voice_level += (target - self.smooth_voice_level) * 0.75
            else:
                self.smooth_voice_level += (target - self.smooth_voice_level) * 0.18

            if self.smooth_voice_level < 0.01:
                self.smooth_voice_level = 0.0

            # Symmetrical acoustic diaphragm ballistics across 4 pearls
            p_targets = [
                self.smooth_voice_level * 0.70,
                self.smooth_voice_level * 1.00,
                self.smooth_voice_level * 0.96,
                self.smooth_voice_level * 0.72,
            ]
            p_attacks = [0.65, 0.85, 0.82, 0.68]
            p_decays = [0.15, 0.20, 0.19, 0.16]

            for i in range(4):
                pt = p_targets[i]
                if pt > self.pearl_levels[i]:
                    self.pearl_levels[i] += (pt - self.pearl_levels[i]) * p_attacks[i]
                else:
                    self.pearl_levels[i] += (pt - self.pearl_levels[i]) * p_decays[i]

                if self.pearl_levels[i] < 0.005:
                    self.pearl_levels[i] = 0.0

            self.area.queue_draw()

        return True

    def draw(self, widget, cr):
        cr.save()
        cr.set_operator(cairo.OPERATOR_CLEAR)
        cr.paint()
        cr.restore()
        cr.set_operator(cairo.OPERATOR_OVER)

        v = self.smooth_voice_level
        w = 82.0
        h = 24.0
        r = 12.0
        cx = CANVAS_WIDTH / 2.0
        cy = CANVAS_HEIGHT / 2.0
        x0 = cx - (w / 2.0)
        y0 = cy - (h / 2.0)

        # -------------------------------------------------------------
        # 1. TRANSPARENT LIQUID GLASS SUBSTRATE & SHEEN
        # -------------------------------------------------------------
        # Subtle ambient white refraction rim glow (strictly clipped to capsule)
        cr.save()
        draw_rounded_capsule(cr, x0 + 0.5, y0 + 0.5, w - 1.0, h - 1.0, r - 0.5)
        cr.set_source_rgba(1.0, 1.0, 1.0, 0.07 * (0.8 + 0.4 * v))
        cr.set_line_width(2.0)
        cr.stroke()
        cr.restore()

        # Smoked Glass Substrate
        draw_rounded_capsule(cr, x0 + 0.5, y0 + 0.5, w - 1.0, h - 1.0, r - 0.5)
        bg = self.theme["bg_rgba"]
        cr.set_source_rgba(bg[0], bg[1], bg[2], bg[3])
        cr.fill_preserve()

        # Internal diagonal glass refraction sheen
        tint_grad = cairo.LinearGradient(x0, y0, x0 + w, y0 + h)
        for stop_pos, r_val, g_val, b_val, a_val in self.theme["sheen_stops"]:
            tint_grad.add_color_stop_rgba(stop_pos, r_val, g_val, b_val, a_val)
        cr.set_source(tint_grad)
        cr.fill()

        # -------------------------------------------------------------
        # 2. LIQUID GLASS CONVEX DOME SHINE & CRYSTAL BEZEL
        # -------------------------------------------------------------
        # Upper Convex Dome Specular Glint (Inside upper half of capsule)
        cr.save()
        dome_h = (h / 2.0) - 1.5
        dome_r = min(r - 1.5, dome_h / 2.0)
        draw_rounded_capsule(cr, x0 + 1.5, y0 + 1.5, w - 3.0, dome_h, dome_r)
        dome_grad = cairo.LinearGradient(cx, y0 + 1.5, cx, y0 + 1.5 + dome_h)
        dome_grad.add_color_stop_rgba(0.0, 1.0, 1.0, 1.0, self.theme["dome_top"])
        dome_grad.add_color_stop_rgba(0.55, 1.0, 1.0, 1.0, self.theme["dome_mid"])
        dome_grad.add_color_stop_rgba(1.0, 1.0, 1.0, 1.0, 0.0)
        cr.set_source(dome_grad)
        cr.fill()
        cr.restore()

        # Physical Glass Outer Crystal Rim (Exact integer-aligned stroke)
        draw_rounded_capsule(cr, x0 + 0.5, y0 + 0.5, w - 1.0, h - 1.0, r - 0.5)
        rim_grad = cairo.LinearGradient(cx, y0, cx, y0 + h)
        rt = self.theme["rim_top"]
        rb = self.theme["rim_bot"]
        rim_grad.add_color_stop_rgba(0.0, rt[0], rt[1], rt[2], rt[3])
        rim_grad.add_color_stop_rgba(1.0, rb[0], rb[1], rb[2], rb[3])
        cr.set_source(rim_grad)
        cr.set_line_width(1.0)
        cr.stroke()

        # Secondary Inner Refraction Bezel (Optical glass depth)
        draw_rounded_capsule(cr, x0 + 1.5, y0 + 1.5, w - 3.0, h - 3.0, r - 1.5)
        cr.set_source_rgba(1.0, 1.0, 1.0, self.theme["bezel_alpha"])
        cr.set_line_width(0.6)
        cr.stroke()

        # -------------------------------------------------------------
        # 3. STATE: RECORDING (Voice-Synced Breathing Pearls & Timer)
        # -------------------------------------------------------------
        if self.current_state == "recording":
            # --- Right: Pure White Micro Timer with Shadow ---
            elapsed = int(time.time() - self.recording_start_time) if self.recording_start_time else 0
            timer_text = f"{elapsed // 60}:{elapsed % 60:02d}"
            cr.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
            cr.set_font_size(8.5)
            extents = cr.text_extents(timer_text)
            tx = x0 + w - 10.0 - extents.width
            ty = cy - (extents.height / 2.0 + extents.y_bearing)

            # Drop shadow for legibility over bright backgrounds
            cr.move_to(tx + 0.6, ty + 0.6)
            cr.set_source_rgba(0.0, 0.0, 0.0, 0.70)
            cr.show_text(timer_text)

            cr.move_to(tx, ty)
            cr.set_source_rgba(1.0, 1.0, 1.0, 0.98)
            cr.show_text(timer_text)

            # --- Left: 4 Voice-Synced Symmetrical Breathing Pearls ---
            num_beads = 4
            mid_x = x0 + 26.5
            # Pearls breathe slightly outward with vocal volume (5.2px up to 5.7px)
            bead_spacing = 5.2 + (0.5 * self.smooth_voice_level)
            # Symmetrical scale weights: center pearls pulse higher than outer pearls
            # Base radius 1.5px. Center pearls expand to 3.4px, outer to 2.4px.
            max_growths = [0.9, 1.9, 1.9, 0.9]

            for i in range(num_beads):
                idx = i - 1.5  # Symmetrically positions: -1.5, -0.5, +0.5, +1.5
                bx = mid_x + idx * bead_spacing
                by = cy  # Stably anchored on the exact centerline (NO artificial jumping/bouncing)

                pv = self.pearl_levels[i]
                base_r = 1.5
                br = base_r + (max_growths[i] * pv)
                br = max(1.4, min(3.5, br))

                # Contact shadow
                cr.arc(bx, by + 0.6, br * 0.88, 0, 2 * math.pi)
                cr.set_source_rgba(0.0, 0.0, 0.0, 0.50)
                cr.fill()

                # Pure white / silver pearl gradient (intensifies in brightness with voice)
                b_grad = cairo.RadialGradient(bx - br * 0.25, by - br * 0.25, 0.15, bx, by, br)
                b_grad.add_color_stop_rgba(0.0, 1.0, 1.0, 1.0, 1.0)
                b_grad.add_color_stop_rgba(0.55, COLOR_PEARL_SILVER[0], COLOR_PEARL_SILVER[1], COLOR_PEARL_SILVER[2], 0.88 + 0.12 * pv)
                b_grad.add_color_stop_rgba(1.0, 0.35, 0.35, 0.35, 0.0)

                cr.arc(bx, by, br, 0, 2 * math.pi)
                cr.set_source(b_grad)
                cr.fill()

                # Crisp micro specular reflection on the upper-left of each pearl
                cr.arc(bx - br * 0.35, by - br * 0.35, br * 0.26, 0, 2 * math.pi)
                cr.set_source_rgba(1.0, 1.0, 1.0, 0.98)
                cr.fill()

        # -------------------------------------------------------------
        # 4. STATE: TRANSCRIBING (Pure White Crystal Spinner & Shimmer)
        # -------------------------------------------------------------
        elif self.current_state == "transcribing":
            spin_x = x0 + 13.0
            spin_r = 3.4
            angle = (self.anim_time * 6.5) % (2 * math.pi)

            # Background subtle ring
            cr.arc(spin_x, cy, spin_r, 0, 2 * math.pi)
            cr.set_source_rgba(1.0, 1.0, 1.0, 0.16)
            cr.set_line_width(1.2)
            cr.stroke()

            # Active illuminated pure white arc
            cr.arc(spin_x, cy, spin_r, angle, angle + 1.25 * math.pi)
            cr.set_source_rgba(1.0, 1.0, 1.0, 0.98)
            cr.set_line_cap(cairo.LINE_CAP_ROUND)
            cr.set_line_width(1.2)
            cr.stroke()

            # Shimmering pure white label
            shimmer = 0.75 + 0.25 * math.sin(self.anim_time * 4.0)
            cr.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
            cr.set_font_size(8.0)
            extents = cr.text_extents("Processing...")
            tx = spin_x + 9.0
            ty = cy - (extents.height / 2.0 + extents.y_bearing)

            # Drop shadow for transparent background legibility
            cr.move_to(tx + 0.6, ty + 0.6)
            cr.set_source_rgba(0.0, 0.0, 0.0, 0.60)
            cr.show_text("Processing...")

            cr.move_to(tx, ty)
            cr.set_source_rgba(1.0, 1.0, 1.0, shimmer)
            cr.show_text("Processing...")

        return False


def main():
    parser = argparse.ArgumentParser(
        description="Voxtype Pure B&W Liquid Glass Dynamic Island OSD",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="Available themes:\n" + "\n".join(f"  {k:12s} - {v['description']}" for k, v in THEMES.items()),
    )
    parser.add_argument("--demo", action="store_true", help="Launch in interactive demo preview mode")
    parser.add_argument(
        "--theme",
        choices=list(THEMES.keys()),
        default="dark-glass",
        help="Visual theme (default: dark-glass)",
    )
    parser.add_argument(
        "--top-margin",
        type=int,
        default=36,
        help="Vertical offset in pixels from the top of the screen (default: 36)",
    )
    args = parser.parse_args()

    # Graceful termination on SIGINT and SIGTERM via GLib main loop signal sources
    def _sig_handler(*_):
        Gtk.main_quit()
        return GLib.SOURCE_REMOVE

    if GLibUnix and hasattr(GLibUnix, 'signal_add'):
        GLibUnix.signal_add(GLib.PRIORITY_HIGH, signal.SIGINT, _sig_handler)
        GLibUnix.signal_add(GLib.PRIORITY_HIGH, signal.SIGTERM, _sig_handler)
    elif hasattr(GLib, 'unix_signal_add'):
        GLib.unix_signal_add(GLib.PRIORITY_HIGH, signal.SIGINT, _sig_handler)
        GLib.unix_signal_add(GLib.PRIORITY_HIGH, signal.SIGTERM, _sig_handler)
    else:
        signal.signal(signal.SIGINT, lambda *s: Gtk.main_quit())
        signal.signal(signal.SIGTERM, lambda *s: Gtk.main_quit())

    win = DynamicIslandOSD(
        demo_mode=args.demo,
        theme_name=args.theme,
        top_margin=args.top_margin,
    )
    Gtk.main()


if __name__ == "__main__":
    main()
